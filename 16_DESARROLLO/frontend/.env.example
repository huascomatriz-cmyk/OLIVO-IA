# =====================================================================
# BRUZZONE IA · MVP · Variables de entorno (ejemplo)
# Copiar a ".env" (o ".env.local" en Next.js) y completar con los valores
# del proyecto Supabase. NUNCA subir el .env real al repositorio.
# =====================================================================

# URL del proyecto Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Para Next.js usar además:
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública anónima (Settings → API → Project API keys → anon public)
# Es pública por diseño: la seguridad real la dan las políticas RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...ANON_KEY...
# Next.js:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...ANON_KEY...

# ⚠️ NUNCA poner aquí (ni en el frontend) la service_role key.
# La service_role solo se usa en backend/administración.

# ID del predio Olivar Los Loros (del seed)
VITE_ID_PREDIO=22222222-2222-2222-2222-222222222222
